# 高德 Web 端 JS API Key：浏览器加载地图必须用到，生产环境请在高德控制台限制域名。
AMAP_JS_KEY=

# 如果你的高德控制台启用了安全密钥，请填写 securityJsCode。
AMAP_SECURITY_JS_CODE=

# 高德 WebService Key：后端用于搜索公共厕所和步行路线规划，不会直接暴露给前端。
AMAP_WEB_SERVICE_KEY=

# 海外地点识别、地点搜索、厕所和地铁，仅供后端使用。
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_TIMEOUT_MS=4000

# 本地服务端口，可不填。
PORT=5174
