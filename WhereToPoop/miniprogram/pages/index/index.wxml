<view class="page {{darkMode ? 'dark' : ''}}">
  <view class="map-wrap">
    <map
      id="mainMap"
      class="map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      show-location
      markers="{{markers}}"
      subkey="{{mapSubkey}}"
      layer-style="{{mapLayerStyle}}"
      bindmarkertap="onMarkerTap"
    />

    <cover-view class="brand">
      <cover-view>
        <cover-view class="eyebrow">拉了么</cover-view>
        <cover-view class="title">附近厕所</cover-view>
      </cover-view>
      <cover-view class="status">{{statusText}}</cover-view>
    </cover-view>

    <cover-view class="tools">
      <cover-view class="tool locate-tool" bindtap="onLocateTap">
        <cover-image class="locate-icon" src="/assets/icon_location.png"></cover-image>
      </cover-view>
      <cover-view class="tool metro-tool" bindtap="onShowMetroTap">铁</cover-view>
      <cover-view class="tool theme-tool" bindtap="onThemeTap">{{darkMode ? '日' : '夜'}}</cover-view>
    </cover-view>
  </view>

  <view class="panel">
    <view class="search-box">
      <view class="search-line">
        <view class="city-select" bindtap="onCityPickerTap">
          <text class="city-select-name">{{cityKeyword || '城市'}}</text>
          <text class="city-select-arrow">▾</text>
        </view>
        <input class="input place-input" value="{{placeKeyword}}" placeholder="小区、商场、地铁站或地址" bindinput="onPlaceInput" confirm-type="search" bindconfirm="onPlaceSearchTap" />
        <button class="small-button secondary" bindtap="onPlaceSearchTap">搜地点</button>
      </view>
      <view class="action-row">
        <picker mode="selector" range="{{radiusOptions}}" bindchange="onRadiusChange">
          <view class="filter">半径 {{radiusText}}</view>
        </picker>
        <button class="primary search-action" bindtap="onSearchTap">查厕所</button>
      </view>
    </view>

    <view class="panel-head">
      <view>
        <text class="eyebrow">结果</text>
        <view class="panel-title">{{resultTitle}}</view>
      </view>
      <view class="count">{{resultCount}}</view>
    </view>

    <scroll-view class="list" scroll-y>
      <block wx:if="{{panelMode === 'places'}}">
        <view wx:for="{{places}}" wx:key="id" class="card" data-index="{{index}}" bindtap="onPlaceTap">
          <view class="card-main">
            <text class="card-title">{{item.name}}</text>
            <text class="card-sub">{{item.address || '暂无地址'}}</text>
            <text class="card-meta">{{item.metaText}}</text>
          </view>
          <view class="action-chip" data-index="{{index}}" catchtap="onPlaceUseTap">选定</view>
        </view>
      </block>

      <block wx:elif="{{panelMode === 'toilets'}}">
        <view wx:for="{{toilets}}" wx:key="id" class="card" data-index="{{index}}" bindtap="onToiletTap">
          <view class="card-main">
            <text class="card-title">{{item.name}}</text>
            <text class="card-sub">{{item.address || '暂无地址'}}</text>
            <text class="card-meta">{{item.distanceText}}</text>
          </view>
          <view class="card-actions">
            <view class="action-chip small nav" data-index="{{index}}" catchtap="onToiletNavigateTap">导航</view>
          </view>
        </view>
      </block>

      <block wx:elif="{{panelMode === 'metro'}}">
        <view wx:for="{{metroStations}}" wx:key="name" class="card metro-card" data-index="{{index}}" bindtap="onMetroTap">
          <view class="card-main">
            <text class="card-title">{{item.name}}</text>
            <text class="card-sub">{{item.lineName}}</text>
            <text class="card-meta">{{item.toiletText}} · {{item.distanceText}}</text>
          </view>
          <view class="metro-actions">
            <view class="metro-dot {{item.statusClass}}"></view>
            <view class="card-actions">
              <view class="action-chip small nav" data-index="{{index}}" catchtap="onMetroNavigateTap">导航</view>
            </view>
          </view>
        </view>
      </block>

      <block wx:elif="{{panelMode === 'detail'}}">
        <view class="detail-card">
          <text class="card-title">{{detail.title}}</text>
          <text class="card-sub">{{detail.subtitle}}</text>
          <text class="card-meta">{{detail.toiletText || detail.meta}}</text>
          <block wx:if="{{detail.type === 'place'}}">
            <button class="primary" bindtap="onSearchTap">查找周围厕所</button>
          </block>
          <view wx:else class="detail-actions">
            <button class="primary nav-primary" bindtap="onNavigateTap">导航</button>
          </view>
        </view>
      </block>

      <view wx:else class="empty">暂无结果</view>
    </scroll-view>
  </view>

  <view wx:if="{{cityPanelVisible}}" class="city-mask" catchtap="onCityPanelClose">
    <view class="city-sheet" catchtap="noop">
      <view class="city-sheet-head">
        <text class="city-sheet-title">选择城市</text>
        <text class="city-close" bindtap="onCityPanelClose">×</text>
      </view>
      <scroll-view class="city-scroll" scroll-y>
        <view class="city-section-title">推荐城市</view>
        <view class="city-chip-grid recommended-grid">
          <view wx:for="{{recommendedCities}}" wx:key="*this" class="city-chip" data-city="{{item}}" bindtap="onCitySelectTap">{{item}}</view>
        </view>

        <view class="city-section-title">城市开头字母</view>
        <view class="letter-grid">
          <view wx:for="{{cityLetters}}" wx:key="*this" class="letter-chip {{activeCityLetter === item ? 'active' : ''}}" data-letter="{{item}}" bindtap="onCityLetterTap">{{item}}</view>
        </view>

        <view class="letter-title">{{activeCityLetter}}</view>
        <view class="city-list">
          <view wx:for="{{visibleCities}}" wx:key="*this" class="city-list-item" data-city="{{item}}" bindtap="onCitySelectTap">{{item}}</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
