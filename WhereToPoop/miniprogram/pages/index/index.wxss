page {
  height: 100vh;
  overflow: hidden;
}

view,
button,
input,
picker,
scroll-view {
  box-sizing: border-box;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #eef2ef;
  color: #17211b;
}

.page.dark {
  background: #111713;
  color: #eef5ee;
}

.map-wrap {
  position: relative;
  height: calc(100vh - 640rpx);
  min-height: 430rpx;
}

.map {
  width: 100%;
  height: 100%;
}

.brand {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 22rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 36rpx rgba(21, 31, 25, 0.18);
}

.dark .brand {
  background: rgba(20, 25, 22, 0.92);
}

.eyebrow {
  display: block;
  color: #68736c;
  font-size: 22rpx;
  line-height: 1.2;
}

.dark .eyebrow {
  color: #a7b2ac;
}

.title {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.status {
  max-width: 240rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #2374ab;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tools {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tool {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  color: #17211b;
  background: rgba(255, 255, 255, 0.94);
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 28rpx rgba(21, 31, 25, 0.16);
}

.locate-tool {
  position: relative;
}

.locate-icon {
  width: 44rpx;
  height: 54rpx;
}

.dark .tool {
  color: #eef5ee;
  background: rgba(20, 25, 22, 0.94);
}

.panel {
  display: flex;
  flex-direction: column;
  height: 640rpx;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top-left-radius: 18rpx;
  border-top-right-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 36rpx rgba(21, 31, 25, 0.12);
}

.dark .panel {
  background: rgba(20, 25, 22, 0.96);
}

.search-box {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.search-line,
.action-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  width: 100%;
  min-width: 0;
}

.city-select {
  flex: 0 0 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 150rpx;
  min-width: 0;
  height: 64rpx;
  border-radius: 10rpx;
  color: #17211b;
  background: #edf1ee;
  font-size: 25rpx;
  font-weight: 700;
}

.city-select-name {
  max-width: 104rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.city-select-arrow {
  color: #68736c;
  font-size: 24rpx;
  line-height: 1;
}

.dark .city-select {
  color: #eef5ee;
  background: #26302a;
}

.dark .city-select-arrow {
  color: #a7b2ac;
}

.input {
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
  height: 64rpx;
  min-height: 64rpx;
  border: 1rpx solid rgba(24, 32, 27, 0.12);
  border-radius: 10rpx;
  padding: 0 18rpx;
  color: #17211b;
  background: #fff;
  font-size: 26rpx;
}

.dark .input {
  border-color: rgba(238, 245, 238, 0.14);
  color: #eef5ee;
  background: #111713;
}

.small-button,
.filter {
  display: block;
  width: 100%;
  min-width: 0;
  height: 64rpx;
  margin: 0;
  padding: 0 10rpx;
  border: 0;
  border-radius: 10rpx;
  color: #17211b;
  background: #edf1ee;
  font-size: 24rpx;
  line-height: 64rpx;
  text-align: center;
}

.small-button {
  flex: 0 0 142rpx;
  width: 142rpx;
  max-width: 142rpx;
  overflow: hidden;
  white-space: nowrap;
}

.small-button::after,
.filter::after,
.primary::after {
  border: 0;
}

.dark .small-button,
.dark .filter {
  color: #eef5ee;
  background: #26302a;
}

.primary {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  margin: 12rpx 0 0;
  border: 0;
  border-radius: 12rpx;
  color: #fff;
  background: #18a058;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.search-action {
  flex: 0 0 150rpx;
  width: 150rpx;
  max-width: 150rpx;
  height: 64rpx;
  margin: 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  line-height: 64rpx;
}

.primary.secondary {
  color: #17211b;
  background: #edf1ee;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.panel-title {
  max-width: 560rpx;
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.count {
  min-width: 56rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  text-align: center;
  color: #fff;
  background: #17211b;
  font-size: 24rpx;
  font-weight: 800;
}

.dark .count {
  color: #101511;
  background: #eef5ee;
}

picker {
  display: block;
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
}

.list {
  flex: 1;
  min-height: 0;
}

.card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 94rpx;
  gap: 14rpx;
  align-items: stretch;
  margin-bottom: 12rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(24, 32, 27, 0.12);
  border-radius: 12rpx;
  background: #fff;
}

.dark .card,
.dark .detail-card {
  border-color: rgba(238, 245, 238, 0.14);
  background: #1a211d;
}

.card-main,
.detail-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.card-title {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-sub,
.card-meta {
  overflow: hidden;
  color: #68736c;
  font-size: 23rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dark .card-sub,
.dark .card-meta {
  color: #a7b2ac;
}

.route-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  overflow: hidden;
  border-radius: 10rpx;
  color: #fff;
  background: #2374ab;
  font-size: 24rpx;
  font-weight: 800;
}

.metro-dot {
  align-self: center;
  justify-self: center;
  width: 28rpx;
  height: 28rpx;
  border: 6rpx solid #fff;
  border-radius: 50%;
  background: #18a058;
  box-shadow: 0 0 0 4rpx rgba(24, 160, 88, 0.2);
}

.detail-card {
  width: 100%;
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid rgba(24, 32, 27, 0.12);
  border-radius: 12rpx;
  background: #fff;
}

.empty {
  padding: 28rpx 4rpx;
  color: #68736c;
  font-size: 26rpx;
}

.city-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.28);
}

.city-sheet {
  width: 100%;
  max-height: 86vh;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  background: #fff;
}

.dark .city-sheet {
  background: #141916;
}

.city-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.city-sheet-title {
  color: #17211b;
  font-size: 34rpx;
  font-weight: 800;
}

.dark .city-sheet-title {
  color: #eef5ee;
}

.city-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  color: #68736c;
  background: #f2f4f3;
  font-size: 46rpx;
  line-height: 58rpx;
  text-align: center;
}

.city-scroll {
  max-height: calc(86vh - 130rpx);
}

.city-section-title,
.letter-title {
  margin: 20rpx 0 16rpx;
  color: #8a918d;
  font-size: 28rpx;
}

.city-chip-grid,
.letter-grid {
  display: grid;
  gap: 18rpx;
}

.recommended-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.letter-grid {
  grid-template-columns: repeat(6, minmax(0, 1fr));
}

.city-chip,
.letter-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 70rpx;
  border-radius: 24rpx;
  color: #151a17;
  background: #f3f4f3;
  font-size: 30rpx;
}

.letter-chip {
  height: 62rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
}

.letter-chip.active {
  color: #fff;
  background: #18a058;
}

.city-list {
  border-top: 1rpx solid rgba(24, 32, 27, 0.08);
}

.city-list-item {
  height: 92rpx;
  border-bottom: 1rpx solid rgba(24, 32, 27, 0.08);
  color: #151a17;
  font-size: 32rpx;
  line-height: 92rpx;
}

.dark .city-section-title,
.dark .letter-title,
.dark .city-close {
  color: #a7b2ac;
}

.dark .city-chip,
.dark .letter-chip,
.dark .city-close {
  background: #26302a;
  color: #eef5ee;
}

.dark .letter-chip.active {
  color: #fff;
  background: #18a058;
}

.dark .city-list,
.dark .city-list-item {
  border-color: rgba(238, 245, 238, 0.12);
}

.dark .city-list-item {
  color: #eef5ee;
}
